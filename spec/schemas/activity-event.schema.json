{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Stage ActivityEvent",
  "type": "object",
  "required": ["protocolVersion", "type", "runId", "spanId", "sequence", "emittedAt", "operation", "locale", "privacyMode", "capabilities"],
  "properties": {
    "protocolVersion": { "const": "0.1" },
    "type": { "enum": ["turn.started", "tool.started", "tool.slow", "tool.completed", "tool.failed", "turn.completed"] },
    "runId": { "type": "string", "pattern": "^run_[a-f0-9]{8}$" },
    "spanId": { "type": "string", "pattern": "^span_[a-f0-9]{8}$" },
    "sequence": { "type": "integer", "minimum": 1 },
    "emittedAt": { "type": "string", "format": "date-time" },
    "operation": { "type": "object", "required": ["family", "label"], "properties": { "family": { "type": "string" }, "label": { "type": "string", "maxLength": 80 } }, "additionalProperties": false },
    "elapsedMs": { "type": "integer", "minimum": 0 },
    "locale": { "enum": ["zh-CN", "en"] },
    "privacyMode": { "const": "summary-only" },
    "capabilities": { "type": "array", "items": { "enum": ["screen", "audio", "lights", "haptic"] } }
  },
  "additionalProperties": false
}
