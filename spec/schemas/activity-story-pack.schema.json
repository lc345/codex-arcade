{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Stage Activity Story Pack",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "license", "matches", "chapters"],
  "properties": {
    "schemaVersion": { "const": "3" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "string" },
    "license": { "type": "string" },
    "priority": { "type": "integer" },
    "matches": { "type": "object", "required": ["families"], "properties": { "families": { "type": "array", "minItems": 1, "items": { "type": "string" } } }, "additionalProperties": false },
    "chapters": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "on", "timeline"], "properties": { "id": { "type": "string" }, "on": { "type": "array", "minItems": 1, "items": { "enum": ["turn.started", "tool.started", "tool.slow", "tool.completed", "tool.failed", "turn.completed"] } }, "timeline": { "type": "object" } }, "additionalProperties": false } }
  },
  "additionalProperties": false
}
