    "test:shadow-browser": "node tools/test-shadow-browser.mjs",
    "test:dice-browser": "node tools/test-dice-browser.mjs",
    "test:appliance-browser": "node tools/test-appliance-browser.mjs",
    "test:toast-browser": "node tools/test-toast-browser.mjs",
    "test:one-button-browser": "node tools/test-one-button-browser.mjs",
