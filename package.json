    "test:odd-browser": "node tools/test-odd-ten-browser.mjs",
    "test:odd-dock": "node tools/test-odd-dock.mjs",
    "build:odd-art": "node tools/build-odd-art.mjs",
    "test:sports": "node --test apps/codex-stage/sports-ten/*.test.mjs",
    "test:sports-browser": "node tools/test-sports-ten-browser.mjs",
