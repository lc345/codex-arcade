    "test:challenge-browser": "node tools/test-challenge-ten-browser.mjs",
    "test:challenge-dock": "node tools/test-challenge-dock.mjs",
    "build:challenge-art": "node tools/build-challenge-art.mjs",
    "build:challenge-manifest": "node tools/build-challenge-manifest.mjs",
    "build:arcade": "node tools/build-studio-assets.mjs && node tools/build-game-packs.mjs",
    "test:gauntlet": "node --test apps/codex-stage/gauntlet-ten/*.test.mjs",
    "test:gauntlet-browser": "node tools/test-gauntlet-ten-browser.mjs",
    "test:gauntlet-dock": "node tools/test-gauntlet-dock.mjs",
    "build:gauntlet-art": "node tools/build-gauntlet-art.mjs",
    "test:hardcore": "node --test apps/codex-stage/hardcore-ten/*.test.mjs",
    "test:hardcore-browser": "node tools/test-hardcore-ten-browser.mjs",
    "test:hardcore-dock": "node tools/test-hardcore-dock.mjs",
    "build:hardcore-art": "node tools/build-hardcore-art.mjs",
    "test:extreme": "node --test apps/codex-stage/extreme-six/*.test.mjs",
    "test:extreme-browser": "node tools/test-extreme-six-browser.mjs",
    "test:extreme-dock": "node tools/test-extreme-dock.mjs",
    "build:extreme-art": "node tools/build-extreme-art.mjs"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pixi.js": "^8.19.0",
    "tone": "^15.1.22"
  }
}
