    "test:py": "PYTHONPATH=packages/core-py python3 -m unittest discover -s packages/core-py/tests -v",
    "test": "npm run test:ts && npm run test:py",
    "verify": "node packages/core-ts/src/cli.ts verify recipes && node packages/core-ts/src/cli.ts verify scene-packs && node packages/stage-core-ts/src/cli.js verify scene-packs",
    "gallery": "node packages/stage-core-ts/src/cli.js gallery scene-packs apps/stage-gallery/packs.json",
    "serve:lab": "node apps/press-lab/server.js",
    "serve:codex-stage": "node apps/press-lab/server.js",
    "codex-stage:daemon": "node packages/codex-stage/src/cli.js",
