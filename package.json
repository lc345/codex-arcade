    "codex-stage:open": "bash macos/scripts/start-agent-stage-macos.sh",
    "codex-stage:check": "node macos/scripts/agent-stage-doctor.mjs",
    "codex-stage:uninstall": "bash macos/scripts/uninstall-agent-stage-macos.sh",
    "release:codex-stage": "bash macos/scripts/build-agent-stage-release.sh",
