    "test:five-dock": "node tools/test-five-dock.mjs",
    "build:grab-manifest": "node tools/build-grab-manifest.mjs",
    "test:grab": "node --test apps/codex-stage/grab-go/*.test.mjs",
    "test:grab-browser": "node tools/test-grab-browser.mjs",
    "build:beacon-assets": "node tools/build-beacon-assets.mjs",
    "build:beacon-manifest": "node tools/build-beacon-assets.mjs --manifest-only",
    "test:beacon": "node --test apps/codex-stage/last-beacon/*.test.mjs",
    "test:beacon-browser": "node tools/test-beacon-browser.mjs",
    "build:statue-manifest": "node tools/build-statue-manifest.mjs",
